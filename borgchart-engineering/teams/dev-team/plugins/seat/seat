#!/bin/sh
set -u
if ! command -v uv >/dev/null 2>&1; then
  echo 'wait: uv is unavailable'
  exit 3
fi
root=$(CDPATH= cd -- "$(dirname "$0")" && pwd) || exit 3
output=$(uv run --quiet --no-project --script "$root/seat.py" "$@")
status=$?
case "$status:$output" in
  0:go:\ *|2:wait:\ *|3:wait:\ *)
    printf '%s\n' "$output"
    exit "$status"
    ;;
  *)
    echo 'wait: seat runtime unavailable'
    exit 3
    ;;
esac
