#!/usr/bin/env bash
# Usage: seed [--scrub evidence-directory]; requires a throwaway HOME.
set -euo pipefail
umask 077
for key in ANTHROPIC_API_KEY OPENAI_API_KEY; do [[ -n ${!key:-} ]] || { echo "$key is empty: add it to the vendor-nightly environment" >&2; exit 1; }; done
if [[ ${1:-} == --scrub ]]; then
  patterns=$(mktemp)
  trap 'rm -f "$patterns"' EXIT
  for key in ANTHROPIC_API_KEY OPENAI_API_KEY; do printenv "$key" >> "$patterns"; printenv "$key" | tail -c 17 >> "$patterns"; done
  printf '%s\n' sk-ant- sk-proj- sk-svcacct- >> "$patterns"
  if grep -rqFf "$patterns" "${2:?evidence directory required}"; then
    echo 'Refusing publication: credential pattern in evidence' >&2; exit 1
  else
    status=$?; [[ $status == 1 ]] || exit "$status"
  fi
  exit 0
fi
[[ $(realpath "$HOME") == "$(realpath "${TMPDIR:-/tmp}")/"* ]] || { echo 'Use a throwaway HOME under TMPDIR' >&2; exit 1; }
export CLAUDE_CONFIG_DIR="$HOME/.claude" CODEX_HOME="$HOME/.codex"
mkdir -p "$HOME/.claude" "$HOME/.codex"
printenv ANTHROPIC_API_KEY > "$HOME/.claude/api-key"
# shellcheck disable=SC2016
printf '#!/bin/sh\ncat "$HOME/.claude/api-key"\n' > "$HOME/.claude/key-helper"
chmod 700 "$HOME/.claude/key-helper"
jq -n --arg workspace "$GITHUB_WORKSPACE" '{hasCompletedOnboarding:true,projects:{($workspace):{hasTrustDialogAccepted:true,hasClaudeMdExternalIncludesApproved:true,hasClaudeMdExternalIncludesWarningShown:true}}}' > "$HOME/.claude.json"
cp "$HOME/.claude.json" "$HOME/.claude/.claude.json"
jq -n '{apiKeyHelper:"sh \"$HOME/.claude/key-helper\"",model:"claude-haiku-5-5",env:{DISABLE_AUTOUPDATER:"1"}}' > "$HOME/.claude/settings.json"
printenv OPENAI_API_KEY | codex login --with-api-key >/dev/null
printf '%s\n' 'model = "gpt-6.1-terra"' 'model_reasoning_effort = "low"' 'check_for_update_on_startup = false' > "$HOME/.codex/config.toml"
printf '\n[projects.%s]\ntrust_level = "trusted"\n' "$(jq -n --arg workspace "$GITHUB_WORKSPACE" '$workspace')" >> "$HOME/.codex/config.toml"
preflight=$(mktemp -d)
trap 'rm -rf "$preflight"' EXIT
cd "$preflight"
for vendor in claude codex; do
  if [[ $vendor == claude ]]; then args=(-p --tools '' 'Reply OK. Use no tools.'); else args=(exec --skip-git-repo-check -s read-only 'Reply OK. Use no tools.'); fi
  if ! output=$("$vendor" "${args[@]}" 2>&1); then
    line=$(printf '%s\n' "$output" | sed '/^[[:space:]]*$/d' | tail -n 1)
    for key in ANTHROPIC_API_KEY OPENAI_API_KEY; do line=${line//"${!key}"/[redacted]}; done
    printf 'API request refused for %s: %s\n' "$vendor" "$line" >&2; exit 1
  fi
done
