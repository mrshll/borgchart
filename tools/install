#!/bin/sh
# Replace the fixed installation without exposing partially copied binaries.
set -eu
fail() { echo "install: $*" >&2; exit 1; }
CDPATH= cd -- "$(dirname "$0")/.."
revision=$(git rev-parse HEAD)
dirty=$(git status --porcelain)
[ -z "$dirty" ] || [ "${ALLOW_DIRTY:-0}" = 1 ] || fail 'checkout is dirty; commit changes or use ALLOW_DIRTY=1'
: "${PREFIX:=$HOME/.local/share}" "${BINDIR:=$HOME/.local/bin}"
mkdir -p "$PREFIX" "$BINDIR"
PREFIX=$(CDPATH= cd -- "$PREFIX" && pwd -P)
BINDIR=$(CDPATH= cd -- "$BINDIR" && pwd -P)
lock=$PREFIX/.brg-install.lock
mkdir "$lock" 2>/dev/null || fail "install lock held at $lock; wait, or remove it after confirming no installer is running"
tmp=
cleanup() {
  if [ -n "$tmp" ]; then
    # Restore teams if a failed or interrupted swap left the path missing.
    if [ -d "$tmp/teams-old" ] && [ ! -e "$PREFIX/brg/teams" ]; then
      mv "$tmp/teams-old" "$PREFIX/brg/teams"
    fi
    rm -rf "$tmp"
  fi
  rmdir "$lock"
}
trap cleanup 0
trap 'exit 1' HUP INT TERM
for name in brg borgchart brg-seat; do
  [ ! -e "$BINDIR/$name" ] || [ -L "$BINDIR/$name" ] || fail "move $BINDIR/$name aside; refusing to replace it"
done
tmp=$(mktemp -d "$PREFIX/.brg-install.XXXXXX")
[ -z "$dirty" ] || revision=$revision-dirty
platform=$(uname -s)
set -- cargo build --release --workspace --bins --locked --message-format=json-render-diagnostics
# cargo-slot requires Linux's flock and systemd; use cargo on other systems.
if [ "$platform" = Linux ] && [ -x tools/cargo-slot ]; then
  set -- tools/cargo-slot "$@"
fi
"$@" > "$tmp/artifacts"
sed -n '/^{.*"reason"[[:space:]]*:[[:space:]]*"compiler-artifact"/p' "$tmp/artifacts" > "$tmp/executables"
mkdir "$tmp/install" "$tmp/install/bin"
for name in brg borgchart brg-seat; do
  # Refuse JSON-escaped paths instead of decoding them incorrectly.
  artifact=$(sed -n 's/.*"executable"[[:space:]]*:[[:space:]]*"\([^"\\]*\/'"$name"'\)".*/\1/p' "$tmp/executables")
  [ -f "$artifact" ] || fail "no single usable artifact for $name; check build targets and use paths without JSON escapes"
  cp "$artifact" "$tmp/install/bin/$name"
done
if [ -n "$dirty" ]; then cp -R teams "$tmp/install/teams"
else git archive HEAD teams > "$tmp/teams.tar"; tar -xf "$tmp/teams.tar" -C "$tmp/install"
fi
printf '%s\n' "$revision" > "$tmp/install/REVISION"
mkdir -p "$PREFIX/brg/bin"
for name in brg borgchart brg-seat; do
  # Staging and destination share a filesystem: mv renames each complete file.
  mv -f "$tmp/install/bin/$name" "$PREFIX/brg/bin/$name"
done
# Portable rename cannot replace a nonempty directory; teams is briefly absent.
[ ! -e "$PREFIX/brg/teams" ] || mv "$PREFIX/brg/teams" "$tmp/teams-old"
mv "$tmp/install/teams" "$PREFIX/brg/teams"
mv -f "$tmp/install/REVISION" "$PREFIX/brg/REVISION"
for name in brg borgchart brg-seat; do
  target=$PREFIX/brg/bin/$name
  [ "$(readlink "$BINDIR/$name" || :)" = "$target" ] || ln -sfn "$target" "$BINDIR/$name"
done
printf 'Installed %s\nAdd to your brg configuration (once):\nteams: [%s/brg/teams]\n' "$revision" "$PREFIX"
