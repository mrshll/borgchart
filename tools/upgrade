#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# ///
"""Collect handovers, stop running trees, install brg, and start them fresh."""

import json
import math
import os
import shlex
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

HANDOVER = (
    "brg upgrade: this tree will be stopped and started fresh. Update your notes "
    "so a fresh start can resume, ask your child teams to do the same and wait "
    "for them, then reply to this message."
)
ROOT = Path(__file__).resolve().parent.parent
BRG = os.environ.get("BRG") or "brg"
BRG_BUILT = os.environ.get("BRG_BUILT") or str(ROOT / "target/release/brg")


def say(message: str) -> None:
    print(message, flush=True)


def run(*args: str, timeout: float | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [BRG, *args], capture_output=True, text=True, check=False, timeout=timeout
    )


def data(result: subprocess.CompletedProcess[str]) -> Any:
    if result.returncode:
        raise RuntimeError(
            result.stderr.strip() or result.stdout.strip() or "brg failed"
        )
    return json.loads(result.stdout)


def live(row: dict[str, Any]) -> bool:
    return (
        row["kind"] == "member"
        and row["state"] not in ("stopped", "not started", "exited")
        and row.get("liveness") != "gone"
    )


def secret_teams(rows: list[dict[str, Any]], trees: list[str]) -> list[str]:
    teams = dict.fromkeys(trees)
    for row in rows:
        if row["team"].split("/")[0] in trees and (
            live(row) or (row["kind"] == "plugin" and row["state"] == "alive")
        ):
            teams[row["team"]] = None
    return list(teams)


def check_secrets(teams: list[str], *, handover_sent: bool = False) -> bool:
    for team in teams:
        say(f"checking: secrets for {team}")
        result = subprocess.run(
            [BRG_BUILT, "secrets", "--check", team],
            stdout=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode:
            say(f"failed: secrets for {team}")
            sent = "handover messages were sent; " if handover_sent else ""
            untouched = (
                "stopped or installed"
                if handover_sent
                else "sent, stopped or installed"
            )
            say(f"summary: secrets check failed; {sent}nothing {untouched}")
            return False
    return True


def wait_for_replies(pending: list[tuple[str, str, str]], deadline: float) -> bool:
    def accept(team: str, records: list[dict[str, Any]]) -> None:
        for record in records:
            for item in list(pending):
                tree, sender, sent = item
                if (
                    tree == team
                    and record["from"] == sender
                    and sent in record.get("reply_to", [])
                ):
                    data(run("msg", "ack", "--team", tree, record["id"], "--json"))
                    pending.remove(item)
                    say(f"replied: {sender} to {sent}")

    def scan() -> None:
        for team in dict.fromkeys(item[0] for item in pending):
            accept(team, data(run("msg", "list", "--team", team, "--json"))["records"])

    while pending:
        scan()
        if not pending:
            return True
        team = pending[0][0]
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        try:
            # msg wait accepts at least 60 seconds; bound the process by our
            # remaining global deadline even when less than 60 seconds remain.
            result = run(
                "msg",
                "wait",
                "--team",
                team,
                "--json",
                "--timeout",
                str(max(60, min(86400, math.ceil(remaining)))),
                timeout=remaining,
            )
        except subprocess.TimeoutExpired:
            break
        if result.returncode == 9:
            if remaining > 86400:
                continue
            break
        accept(team, data(result)["records"])
    scan()
    for tree, sender, sent in pending:
        say(
            f"timeout: {tree} awaiting {sender}; message was sent ({sent}) and is "
            f"not retracted; inspect with: {shlex.join([BRG, 'status', tree])}"
        )
    return not pending


def outside_stop_set(rows: list[dict[str, Any]], trees: list[str]) -> bool:
    members = [
        f"{row['team']}/{row['member']}"
        for row in rows
        if live(row) and row["team"].split("/")[0] not in trees
    ]
    if members:
        say(f"refused: live members outside the stop set: {', '.join(members)}; retry")
    return bool(members)


def make(*targets: str) -> bool:
    say(f"{'build' if targets[-1] == 'build' else 'install'}: make {' '.join(targets)}")
    return (
        subprocess.run(
            [*shlex.split(os.environ.get("MAKE") or "make"), "-C", str(ROOT), *targets],
            check=False,
        ).returncode
        == 0
    )


def start(trees: list[str]) -> bool:
    ok = True
    for tree in trees:
        result = run("start", tree)
        say(f"{'started' if result.returncode == 0 else 'failed'}: {tree}")
        if result.returncode:
            say(result.stderr.strip() or result.stdout.strip())
            ok = False
    return ok


def main() -> int:
    if any(
        os.environ.get(f"BORGCHART_{key}")
        for key in ("TEAM", "MEMBER", "INCARNATION", "ROLE", "NOTES", "PARENT")
    ):
        raise RuntimeError("run make upgrade from your own shell, outside any member")
    timeout = float(os.environ.get("TIMEOUT") or "1800")
    if not math.isfinite(timeout) or timeout <= 0:
        raise ValueError("TIMEOUT must be a positive number of seconds")
    force = os.environ.get("FORCE") == "1"
    flags = os.environ.get("MAKEFLAGS", "").split()
    dry_run = os.environ.get("DRY_RUN") == "1" or bool(
        flags and not flags[0].startswith("--") and any(c in flags[0] for c in "ntq")
    )
    rows = data(run("status", "--json"))
    leads: dict[str, list[str]] = {}
    members: dict[str, list[str]] = {}
    for row in rows:
        if live(row):
            tree = row["team"].split("/")[0]
            members.setdefault(tree, []).append(f"{row['team']}/{row['member']}")
            if "/" not in row["team"] and not row.get("parent"):
                leads.setdefault(tree, []).append(f"{row['team']}/{row['member']}")
    trees = list(members)
    teams = secret_teams(rows, trees)
    if not force:
        missing = [tree for tree in trees if tree not in leads]
        for tree in missing:
            say(
                f"refused: {tree} has no live root lead; live members: {', '.join(members[tree])}; use FORCE=1 to stop anyway"
            )
        if missing:
            return 1
    if dry_run:
        say("dry-run: build with make build")
        for team in teams:
            say(f"dry-run: check secrets for {team}")
        for tree in trees:
            handover = (
                "skip handover (FORCE=1)"
                if force
                else f"send to {', '.join(leads[tree])}, wait for replies and idle members"
            )
            say(f"dry-run: {tree}: {handover}, stop")
        say("dry-run: copy with make -o build install")
        for tree in trees:
            say(f"dry-run: start {tree} fresh")
        say(f"summary: dry-run; {len(trees)} tree(s); nothing changed")
        return 0
    if not make("build"):
        say("summary: build failed; nothing sent, stopped or installed")
        return 1
    if not check_secrets(teams):
        return 1
    pending = []
    deadline = time.monotonic() + timeout
    if not force:
        for tree, senders in leads.items():
            for sender in senders:
                sent = data(run("msg", "send", sender, HANDOVER, "--json"))["id"]
                pending.append((tree, sender, sent))
                say(f"sent: {sender} ({sent})")
        if not wait_for_replies(pending, deadline):
            say("summary: handover timed out; nothing stopped or installed")
            return 1
    while True:
        rows = data(run("status", "--json"))
        if outside_stop_set(rows, trees):
            return 1
        if force:
            break
        working = [
            f"{row['team']}/{row['member']}"
            for row in rows
            if live(row) and row["state"] == "working"
        ]
        if not working:
            break
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            say(f"refused: working members: {', '.join(working)}; wait or use FORCE=1")
            say("summary: nothing stopped or installed")
            return 1
        time.sleep(min(2, remaining))
    if not check_secrets(
        [team for team in secret_teams(rows, trees) if team not in teams],
        handover_sent=not force and bool(leads),
    ):
        return 1
    stopped = []
    for tree in trees:
        say(f"stopping: {tree}")
        result = run("stop", tree)
        if result.returncode:
            say(
                f"failed: stop {tree}: {result.stderr.strip() or result.stdout.strip()}"
            )
            start(stopped)
            say(
                "summary: stop failed; install skipped; inspect tree status before retrying"
            )
            return 1
        stopped.append(tree)
    try:
        rows = data(run("status", "--json"))
    except (OSError, ValueError, KeyError, TypeError, RuntimeError):
        start(stopped)
        raise
    if outside_stop_set(rows, trees):
        start(stopped)
        return 1
    try:
        # The release build succeeded before handover; install only copies.
        installed = make("-o", "build", "install")
    except OSError as error:
        say(f"failed: install: {error}")
        installed = False
    if not installed:
        say("failed: copy; starting stopped trees again on whatever is installed")
    restarted = start(stopped)
    say(
        f"summary: {'upgraded' if installed and restarted else 'failed'}; {len(stopped)} tree(s) stopped"
    )
    return 0 if installed and restarted else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
        say(f"failed: {error}")
        say("summary: upgrade aborted; inspect tree status before retrying")
        sys.exit(1)
