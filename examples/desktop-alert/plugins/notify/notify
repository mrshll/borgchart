#!/bin/sh
# brg runs this as the bus alert action:
#   notify alert <alert-id> <member> <reason> <pending-count>
# It appends one line to $BORGCHART_STATE_DIR/alerts.log and, when
# notify-send is available, also shows a desktop notification.
set -eu
if [ "$#" -ne 5 ] || [ "$1" != alert ]; then
    echo "usage: notify alert <id> <member> <reason> <pending>" >&2
    exit 2
fi
id=$2 member=$3 reason=$4 pending=$5
log="$BORGCHART_STATE_DIR/alerts.log"
printf '%s run=%s id=%s member=%s reason=%s pending=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$BORGCHART_RUN" "$id" "$member" "$reason" "$pending" >> "$log"
if command -v notify-send >/dev/null 2>&1; then
    notify-send "brg: $member needs you" "$reason, $pending pending (alert $id)" || true
fi
echo "logged to $log"
