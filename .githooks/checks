#!/bin/sh
# The repository's checks, in one place: the git hooks and CI both run them.
#
#   .githooks/checks              # all four: fmt clippy test py
#   .githooks/checks fast         # the fast tier: tests that start no process
#   .githooks/checks harness      # the test harness's own (slow) tests
#   .githooks/checks fmt clippy   # any subset, in the order given
#
# Checks use the shared, memory-capped build slots by default. CHECKS_WRAP
# explicitly replaces the wrapper (and may include arguments).
set -eu
cd "$(git rev-parse --show-toplevel)"

run() {
  name=$1
  shift
  echo "checks: $name: $*" >&2
  # CHECKS_WRAP is split on spaces on purpose: it may be a command with arguments.
  # shellcheck disable=SC2086
  if ! ${CHECKS_WRAP:-./tools/cargo-slot} "$@"; then
    echo "checks: $name failed" >&2
    exit 1
  fi
}

# The test run's tmux directories live under one root per run. Stop every
# server left in it (a test killed before it could clean up, or one that
# forgot) and remove it; print what was found.
test_root=
sweep() {
  [ -n "$test_root" ] && [ -d "$test_root" ] || return 0
  find "$test_root" -type s 2>/dev/null | while IFS= read -r sock; do
    if tmux -S "$sock" list-sessions >/dev/null 2>&1; then
      echo "a running tmux server: $sock"
    else
      echo "a tmux socket: $sock"
    fi
    tmux -S "$sock" kill-server >/dev/null 2>&1 || true
  done
  rm -rf "$test_root"
}

# Run "$@" (a test command) with the test run's tmux root, then fail if it
# left tmux behind.
tmux_tests() {
  name=$1
  shift
  test_root=$(mktemp -d /tmp/brgrun.XXXXXX)
  trap 'sweep >&2' EXIT
  trap 'sweep >&2; exit 130' INT
  trap 'sweep >&2; exit 143' TERM
  # shellcheck disable=SC2086
  run "$name" env \
    BRG_TEST_TMPDIR_ROOT="$test_root" \
    $nowhere \
    "$@"
  left=$(sweep)
  test_root=
  if [ -n "$left" ]; then
    printf 'checks: the tests left tmux behind (now stopped):\n%s\n' "$left" >&2
    echo "checks: $name failed" >&2
    exit 1
  fi
}

# The default tier runs on cargo-nextest when it is installed: it runs the
# tests of every target at once (cargo test runs one target at a time), each
# in its own process. CHECKS_RUNNER=cargo forces cargo test.
nextest() {
  [ "${CHECKS_RUNNER:-}" != cargo ] && cargo nextest --version >/dev/null 2>&1
}

[ "$#" -gt 0 ] || set -- fmt clippy test py
# Inside a team member, BORGCHART_* names that member's real instance and
# message storage, and inside a git hook GIT_DIR names this repository. The
# tests run with them pointing nowhere, so a test that forgets to clear them
# fails instead of writing into the team or the repository. (No value holds
# a space: the list is split on spaces.)
nowhere="GIT_DIR=/nonexistent/caller-repo/.git
  GIT_WORK_TREE=/nonexistent/caller-repo
  BORGCHART_CONFIG=/nonexistent/caller-team/config.yaml
  BORGCHART_STATE_HOME=/nonexistent/caller-team/state
  BORGCHART_STATE_DIR=/nonexistent/caller-team/member-state
  BORGCHART_INSTANCE=caller-team-2222
  BORGCHART_MEMBER=caller-member-2222
  BORGCHART_ROLE=caller-member
  BORGCHART_NOTES=/nonexistent/caller-team/notes
  BORGCHART_INCARNATION=caller-member.0.0
  BORGCHART_BIN=/nonexistent/caller-team/brg
  BORGCHART_TMUX_SOCKET=brg-caller-team
  BORGCHART_TMUX_TMPDIR=/nonexistent/caller-team/tmux"
# The fast tier: the tests that start no tmux and no other process.
fast_tests="--test validate"
for check in "$@"; do
  case $check in
    fmt) run fmt cargo fmt --all --check ;;
    clippy) run clippy cargo clippy --workspace --all-targets --all-features --locked -- -D warnings ;;
    # Built first, so the build may run what it likes; then the tests run
    # with stand-ins that record any tmux, ps, sh, sleep, claude or codex.
    fast)
      run fast cargo test --workspace --all-features --lib --locked --no-run
      run fast .githooks/no-processes env $nowhere cargo test --workspace --all-features --lib --locked
      # shellcheck disable=SC2086
      run fast cargo test -p borgchart --features test-support --locked $fast_tests --no-run
      # shellcheck disable=SC2086
      run fast .githooks/no-processes env $nowhere \
        cargo test -p borgchart --features test-support --locked $fast_tests
      ;;
    test)
      # Integration tests exercise sibling plugin binaries through real shims.
      run build cargo build --workspace --bins --all-features --locked
      if nextest; then
        tmux_tests test cargo nextest run --workspace --all-features --locked
      else
        tmux_tests test cargo test --workspace --all-features --locked
      fi
      ;;
    # Tests of the test harness itself, kept out of the default tier: the
    # tmux watchdog and the live tier's dry run.
    harness)
      run build cargo build --workspace --bins --all-features --locked
      tmux_tests harness cargo test -p borgchart --all-features --locked \
        --test tmux_watchdog -- --ignored
      tmux_tests harness cargo test -p borgchart --all-features --locked \
        --test live -- --ignored --exact dry_run_reaches_every_expected_result
      ;;
    py) run py uv run --no-project --with pytest==8.3.5 pytest -p no:cacheprovider examples/slack-devops/plugins/slackbot/tests tools/tests ;;
    *)
      echo "checks: unknown check '$check' (use fmt, clippy, fast, test, harness or py)" >&2
      exit 2
      ;;
  esac
done
