#!/bin/sh
# The repository's checks, in one place: the git hooks and CI both run them.
#
#   .githooks/checks              # all four: fmt clippy test py
#   .githooks/checks fast         # the fast tier: tests that start no process
#   .githooks/checks fmt clippy   # any subset, in the order given
#
# Set CHECKS_WRAP to a command that prefixes every check, for example a
# script that limits memory or how many builds run at once.
set -eu
cd "$(git rev-parse --show-toplevel)"

run() {
  name=$1
  shift
  echo "checks: $name: $*" >&2
  # CHECKS_WRAP is split on spaces on purpose: it may be a command with arguments.
  # shellcheck disable=SC2086
  if ! ${CHECKS_WRAP:-} "$@"; then
    echo "checks: $name failed" >&2
    exit 1
  fi
}

# The test run's tmux directories live under one root per run. Stop every
# server left in it (a test killed before it could clean up, or one that
# forgot) and remove it; print what was found.
test_root=
sweep() {
  [ -n "$test_root" ] && [ -d "$test_root" ] || return 0
  find "$test_root" -type s 2>/dev/null | while IFS= read -r sock; do
    if tmux -S "$sock" list-sessions >/dev/null 2>&1; then
      echo "a running tmux server: $sock"
    else
      echo "a tmux socket: $sock"
    fi
    tmux -S "$sock" kill-server >/dev/null 2>&1 || true
  done
  rm -rf "$test_root"
}

[ "$#" -gt 0 ] || set -- fmt clippy test py
# Inside a team member, BORGCHART_* names that member's real instance and
# message storage. The tests run with them pointing nowhere, so a test that
# forgets to clear them fails instead of writing into the team. (No value
# holds a space: the list is split on spaces.)
nowhere="BORGCHART_CONFIG=/nonexistent/caller-team/config.yaml
  BORGCHART_STATE_HOME=/nonexistent/caller-team/state
  BORGCHART_STATE_DIR=/nonexistent/caller-team/member-state
  BORGCHART_INSTANCE=caller-team-2222
  BORGCHART_MEMBER=caller-member-2222
  BORGCHART_ROLE=caller-member
  BORGCHART_NOTES=/nonexistent/caller-team/notes
  BORGCHART_INCARNATION=caller-member.0.0
  BORGCHART_BIN=/nonexistent/caller-team/brg
  BORGCHART_TMUX_SOCKET=brg-caller-team
  BORGCHART_TMUX_TMPDIR=/nonexistent/caller-team/tmux"
# The fast tier: the tests that start no tmux and no other process.
fast_tests="--lib --test validate"
for check in "$@"; do
  case $check in
    fmt) run fmt cargo fmt --check ;;
    clippy) run clippy cargo clippy --all-targets --features test-support --locked -- -D warnings ;;
    # Built first, so the build may run what it likes; then the tests run
    # with stand-ins that record any tmux, ps, sh, sleep, claude or codex.
    fast)
      # shellcheck disable=SC2086
      run fast cargo test --features test-support --locked $fast_tests --no-run
      # shellcheck disable=SC2086
      run fast .githooks/no-processes env $nowhere \
        cargo test --features test-support --locked $fast_tests
      ;;
    test)
      test_root=$(mktemp -d /tmp/brgrun.XXXXXX)
      trap 'sweep >&2' EXIT
      trap 'sweep >&2; exit 130' INT
      trap 'sweep >&2; exit 143' TERM
      # shellcheck disable=SC2086
      run test env \
        BRG_TEST_TMPDIR_ROOT="$test_root" \
        $nowhere \
        cargo test --features test-support --locked
      left=$(sweep)
      test_root=
      if [ -n "$left" ]; then
        printf 'checks: the tests left tmux behind (now stopped):\n%s\n' "$left" >&2
        echo "checks: test failed" >&2
        exit 1
      fi
      ;;
    py) run py uv run --no-project --with pytest==8.3.5 pytest -p no:cacheprovider examples/slack-devops/plugins/slackbot/tests examples/github/tests ;;
    *)
      echo "checks: unknown check '$check' (use fmt, clippy, fast, test or py)" >&2
      exit 2
      ;;
  esac
done
